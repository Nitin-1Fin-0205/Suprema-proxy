# Environment Configuration for Suprema Biometric Proxy

# Database Encryption Keys (REQUIRED)
LOCAL_DB_KEY=your-256-bit-database-encryption-key-here
BIOMETRIC_MASTER_KEY=your-256-bit-biometric-template-encryption-key-here

# Server Configuration
PORT=3000
HTTPS_PORT=443

# SSL Certificate paths
SSL_CERT_PATH=./certs/localhost.crt
SSL_KEY_PATH=./certs/localhost.key

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/secure-proxy.log

# API Configuration
REMOTE_API_URL=https://support-backend.onefin.app