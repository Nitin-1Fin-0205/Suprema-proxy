{
  "name": "suprema-proxy",
  "version": "1.0.0",
  "description": "Production-ready proxy server for Suprema biometric devices with auto-start capabilities",
  "main": "src/proxy.js",
  "bin": "src/proxy.js",
  "scripts": {
    "start": "node src/proxy.js",
    "dev": "NODE_ENV=development node src/proxy.js",
    "prod": "NODE_ENV=production node src/proxy.js",
    "build": "pkg . --out-path dist",
    "build-win": "pkg . --targets node18-win-x64 --out-path dist",
    "build-linux": "pkg . --targets node18-linux-x64 --out-path dist",
    "build-mac": "pkg . --targets node18-macos-x64 --out-path dist",
    "build-all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist",
    "install-service": "powershell -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "install-startup": "powershell -ExecutionPolicy Bypass -File scripts/add-to-startup.ps1",
    "install-task": "powershell -ExecutionPolicy Bypass -File scripts/create-task.ps1",
    "install-all": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1 -All",
    "test-exe": "dist\\suprema-proxy.exe",
    "verify-build": "dir dist",
    "clean": "rmdir /s /q dist logs 2>nul || echo Clean completed"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": ["package.json"],
    "outputPath": "dist",
    "targets": ["node18-win-x64"]
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
