    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>MatcherCapture</RootNamespace>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Suprema.UFScanner">
      <HintPath>..\BioMini\bin\Suprema.UFScanner.dll</HintPath>
    </Reference>
    <Reference Include="Suprema.UFMatcher">
      <HintPath>..\BioMini\bin\Suprema.UFMatcher.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
